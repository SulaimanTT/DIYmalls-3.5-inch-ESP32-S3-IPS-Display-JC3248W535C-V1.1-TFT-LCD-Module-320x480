## Code Reference Example

Below is the software initialization blueprint required to mount the storage module cleanly on Core 1 while preventing background memory loop conflicts.

```cpp
#include <SPI.h>
#include <SD.h>
#include "FS.h"

// Explicit hardware bus pin definition constraints
#define SD_CS   10
#define SD_MOSI 11
#define SD_MISO 13
#define SD_SCK  12

// Declare an explicit SPI instance class to prevent driver cross-talk
SPIClass spiSD(HSPI);

void setup() {
  Serial.begin(115200);
  while (!Serial) { delay(10); }

  Serial.println("Initializing Micro SD Storage System...");

  // 1. Assign pins directly to the targeted SPI instance
  spiSD.begin(SD_SCK, SD_MISO, SD_MOSI, SD_CS);

  // 2. Initialise and mount the file system architecture
  if (!SD.begin(SD_CS, spiSD)) {
    Serial.println("SD SPI Mount Failed! Check physical card insertion.");
    
    // SAFE HALT: Delay yields CPU 0 back to FreeRTOS (IDLE0) to avoid TWDT reset
    while (1) {
      delay(1000); 
    }
  }

  Serial.println("SD Card mounted successfully. Ready for read/write operations.");

  // 3. Simple file validation test
  File file = SD.open("/test_log.txt", FILE_WRITE);
  if (file) {
    file.println("ESP32-S3 Storage initialization complete.");
    file.close();
    Serial.println("File system write test passed.");
  }
}

void loop() {
  // Always include a small delay in an empty loop to keep watchdog happy
  delay(10); 
}
```

