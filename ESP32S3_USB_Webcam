/*
 * ESP32-S3 High-Speed Web Serial JPEG Video Streamer
 * Protocol Header: [0xFF, 0xAA, 0xFF, 0xBB] + uint32_t payload_len + JPEG bytes
 * Board: ESP32-S3-CAM
 * Resolution: FRAMESIZE_VGA
 * Quality: 12 (10=Highest Quality, 60=Lowest)
 * Baud Rate: 2000000
 */

#include "esp_camera.h"
#include <Arduino.h>

// =========================================================================
// Exact GPIO Pin Mapping for your ESP32-S3-CAM Board
// =========================================================================
#define PWDN_GPIO_NUM     -1
#define RESET_GPIO_NUM    -1

#define SIOD_GPIO_NUM     4    // CAM_SIOD
#define SIOC_GPIO_NUM     5    // CAM_SIOC

#define VSYNC_GPIO_NUM    6    // CAM_VSYNC
#define HREF_GPIO_NUM     7    // CAM_HREF
#define XCLK_GPIO_NUM     15   // CAM_XCLK
#define PCLK_GPIO_NUM     13   // CAM_PCLK

#define Y9_GPIO_NUM       16   // CAM_Y9
#define Y8_GPIO_NUM       17   // CAM_Y8
#define Y7_GPIO_NUM       18   // CAM_Y7
#define Y6_GPIO_NUM       12   // CAM_Y6
#define Y5_GPIO_NUM       10   // CAM_Y5
#define Y4_GPIO_NUM       8    // CAM_Y4
#define Y3_GPIO_NUM       9    // CAM_Y3
#define Y2_GPIO_NUM       11   // CAM_Y2

#define LED_GPIO_NUM      2    // On-board LED

// Protocol Magic Sync Delimiter Header (4 bytes)
const uint8_t SYNC_HEADER[4] = {0xFF, 0xAA, 0xFF, 0xBB};

void setup() {
  pinMode(LED_GPIO_NUM, OUTPUT);
  digitalWrite(LED_GPIO_NUM, LOW);

  // Native USB CDC OTG Setup
  Serial.begin(2000000);
  Serial.setTxBufferSize(256000); // 256KB Tx Buffer for smooth video throughput
  Serial.setRxBufferSize(2048);
  
  // Wait up to 3s for Web Serial connection
  unsigned long startWait = millis();
  while (!Serial && (millis() - startWait < 3000)) {
    delay(10);
  }

  camera_config_t config;
  config.ledc_channel = LEDC_CHANNEL_0;
  config.ledc_timer   = LEDC_TIMER_0;
  config.pin_d0       = Y2_GPIO_NUM;
  config.pin_d1       = Y3_GPIO_NUM;
  config.pin_d2       = Y4_GPIO_NUM;
  config.pin_d3       = Y5_GPIO_NUM;
  config.pin_d4       = Y6_GPIO_NUM;
  config.pin_d5       = Y7_GPIO_NUM;
  config.pin_d6       = Y8_GPIO_NUM;
  config.pin_d7       = Y9_GPIO_NUM;
  config.pin_xclk     = XCLK_GPIO_NUM;
  config.pin_pclk     = PCLK_GPIO_NUM;
  config.pin_vsync    = VSYNC_GPIO_NUM;
  config.pin_href     = HREF_GPIO_NUM;
  config.pin_sccb_sda = SIOD_GPIO_NUM; // Standard esp32-cam struct uses pin_sccb_sda
  config.pin_sccb_scl = SIOC_GPIO_NUM; // Standard esp32-cam struct uses pin_sccb_scl
  config.pin_pwdn     = PWDN_GPIO_NUM;
  config.pin_reset    = RESET_GPIO_NUM;
  config.xclk_freq_hz = 20000000;
  config.frame_size   = FRAMESIZE_VGA;
  config.pixel_format = PIXFORMAT_JPEG;
  config.grab_mode    = CAMERA_GRAB_LATEST;
  config.fb_location  = CAMERA_FB_IN_PSRAM;
  config.jpeg_quality = 12;
  config.fb_count     = 2; // Double buffering for high FPS

  // Initialize ESP32-S3 Camera
  esp_err_t err = esp_camera_init(&config);
  if (err != ESP_OK) {
    // Flash LED rapidly on failure
    while (true) {
      digitalWrite(LED_GPIO_NUM, HIGH);
      delay(100);
      digitalWrite(LED_GPIO_NUM, LOW);
      delay(100);
    }
  }

  // Turn on LED briefly to indicate camera ready
  digitalWrite(LED_GPIO_NUM, HIGH);
  delay(300);
  digitalWrite(LED_GPIO_NUM, LOW);
}

void loop() {
  // Capture camera frame
  camera_fb_t * fb = esp_camera_fb_get();
  if (!fb) {
    return;
  }

  uint32_t payload_len = fb->len;

  // 1. Send 4-Byte Magic Sync Header: [0xFF, 0xAA, 0xFF, 0xBB]
  Serial.write(SYNC_HEADER, 4);

  // 2. Send 4-Byte Little Endian Payload Size (N)
  Serial.write((uint8_t*)&payload_len, 4);

  // 3. Send JPEG Payload Bytes
  Serial.write(fb->buf, fb->len);

  // Flush buffer to ensure instant delivery over USB
  Serial.flush();

  // Return frame buffer to camera driver
  esp_camera_fb_return(fb);

  // Check incoming commands from browser over Web Serial
  if (Serial.available()) {
    char cmd = Serial.read();
    if (cmd == 'L' || cmd == 'l') { // Flashlight On
      digitalWrite(LED_GPIO_NUM, HIGH);
    } else if (cmd == 'F' || cmd == 'f') { // Flashlight Off
      digitalWrite(LED_GPIO_NUM, LOW);
    } else if (cmd == 'R' || cmd == 'r') { // Reboot ESP32
      ESP.restart();
    }
  }

  // Tiny delay to prevent buffer bloat
  delay(1);
}
